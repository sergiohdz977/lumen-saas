# Cloudinary credentials (Dashboard -> Settings -> API Keys).
# Leave empty to use local storage (files under media/).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis / Memurai broker for Celery background tasks.
REDIS_URL=redis://127.0.0.1:6379/0

# Django (production: set DJANGO_DEBUG=0 and a real DJANGO_SECRET_KEY;
# generate one with: python -c "from django.core.management.utils import \
# get_random_secret_key; print(get_random_secret_key())").
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL (leave POSTGRES_DB empty to use local SQLite for development).
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Public base URL, used inside emailed share links.
SITE_URL=http://127.0.0.1:8000

# Stripe payments (Dashboard -> Developers -> API keys). Use test keys
# first (they start with sk_test_). The webhook secret comes from the
# webhook endpoint configuration (signing secret, whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly price of the Pro plan (Stripe dashboard -> Products -> Prices).
STRIPE_PRO_PRICE_ID=
